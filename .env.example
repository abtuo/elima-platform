VITE_APP_ENV=development
# `auto` détecte demo.app.elima.ci au runtime. Utiliser `demo` seulement pour un déploiement séparé.
VITE_APP_MODE=auto
VITE_WEB_BASE_URL=https://www.elima.ci

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identité centrale elima.ci (OAuth public, aucun secret navigateur).
VITE_ELIMA_IDENTITY_URL=
VITE_ELIMA_OAUTH_CLIENT_ID=
VITE_ELIMA_OAUTH_REDIRECT_URI=https://app.elima.ci/auth/elima/callback
# Clé publique du projet d’identité elima.ci, utilisée uniquement côté fonction Vercel.
ELIMA_IDENTITY_PUBLISHABLE_KEY=

VITE_MAIN_API_BASE_URL=
# Optionnel : URL d'un backend de révision séparé. La génération locale utilise directement Azure côté serveur Vite.
VITE_REVISION_API_BASE_URL=

VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_REVISION=true
VITE_ENABLE_STUDENT_SCANNER=true
VITE_ENABLE_TEACHER_OFFLINE=true
VITE_ENABLE_WHATSAPP_OPTION=false

# Configuration backend uniquement. Ne jamais ajouter le préfixe VITE_.
# Scripts de migration/seed uniquement. Doit appartenir au même projet que VITE_SUPABASE_URL.
SUPABASE_SECRET_KEY=
# Connexion PostgreSQL directe du nouveau projet, nécessaire pour appliquer le schéma.
SUPABASE_DB_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_API_KEY=
ACS_ENDPOINT=
ACS_ACCESS_KEY=
ACS_WHATSAPP_CHANNEL_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
PAYMENT_PROVIDER_SECRET=
BLOB_READ_WRITE_TOKEN=
