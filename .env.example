VITE_APP_ENV=development
VITE_WEB_BASE_URL=https://www.elima.ci

VITE_MAIN_SUPABASE_URL=
VITE_MAIN_SUPABASE_ANON_KEY=

VITE_REVISION_SUPABASE_URL=
VITE_REVISION_SUPABASE_ANON_KEY=

# URL HTTPS du backend sécurisé principal (uploads et opérations serveur).
VITE_MAIN_API_BASE_URL=
# URL HTTPS du backend IA/OCR sécurisé de la Révision.
VITE_REVISION_API_BASE_URL=

VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_REVISION=true
VITE_ENABLE_STUDENT_SCANNER=true
VITE_ENABLE_TEACHER_OFFLINE=true
VITE_ENABLE_WHATSAPP_OPTION=false

# Configuration backend uniquement. Ne jamais ajouter le préfixe VITE_.
# Base scolaire principale.
SUPABASE_MAIN_SERVICE_ROLE_KEY=
# Base Révision indépendante.
SUPABASE_REVISION_SERVICE_ROLE_KEY=

# Azure OpenAI : endpoint, nom exact du déploiement et clé serveur.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=

# Azure Document Intelligence pour l'OCR.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# Backend OpenAI non-Azure, optionnel.
OPENAI_API_KEY=

# Notifications serveur, optionnelles selon le fournisseur choisi.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_API_KEY=
ACS_ENDPOINT=
ACS_ACCESS_KEY=
ACS_WHATSAPP_CHANNEL_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Paiements et stockage serveur.
PAYMENT_PROVIDER_SECRET=
BLOB_READ_WRITE_TOKEN=
