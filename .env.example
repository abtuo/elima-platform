# Toutes les variables VITE_* sont publiques dans le bundle client. Aucun secret serveur.
VITE_APP_ENV=development
# `auto` détecte demo.app.elima.ci au runtime. Utiliser `demo` seulement pour un déploiement séparé.
VITE_APP_MODE=auto
VITE_WEB_BASE_URL=https://elima.ci
VITE_PUBLIC_APP_URL=https://app.elima.ci

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_DEMO_PROJECT_ID=
VITE_SUPABASE_PRODUCTION_PROJECT_ID=

# Identité centrale elima.ci (OAuth public, aucun secret navigateur).
VITE_ELIMA_IDENTITY_URL=
VITE_ELIMA_OAUTH_CLIENT_ID=
VITE_ELIMA_OAUTH_REDIRECT_URI=https://app.elima.ci/auth/elima/callback
# Configuration explicite du même projet pour apps/api.
ELIMA_IDENTITY_URL=
ELIMA_IDENTITY_PUBLISHABLE_KEY=
# Clé serveur du même projet d’identité. Backend uniquement.
ELIMA_IDENTITY_SECRET_KEY=

# Cible technique du bridge Révision. Projet distinct de l'identité centrale.
REVISION_SUPABASE_URL=
REVISION_SUPABASE_SECRET_KEY=

# Twilio Verify WhatsApp. Backend apps/api uniquement.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

VITE_MAIN_API_BASE_URL=
# Origine du backend Elima (sans /api, credentials, query ni fragment).
# Vide = same-origin web/dev. Exemple : https://backend.example.com
# HTTPS obligatoire pour les builds de production ; HTTP loopback autorisé en dev uniquement.
VITE_REVISION_API_BASE_URL=

VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_REVISION=true
VITE_ENABLE_STUDENT_SCANNER=true
VITE_ENABLE_TEACHER_OFFLINE=true
VITE_ENABLE_WHATSAPP_OPTION=false

# Configuration backend uniquement. Ne jamais ajouter le préfixe VITE_.
# Origines CORS additionnelles exactes, séparées par des virgules (pas de wildcard).
# Exemple documentaire : https://localhost,https://revision.example.com
# Les appels same-origin et sans Origin restent acceptés par leurs guards métier.
REVISION_ALLOWED_ORIGINS=
# Scripts de migration/seed uniquement. Doit appartenir au même projet que VITE_SUPABASE_URL.
SUPABASE_SECRET_KEY=
# Connexion PostgreSQL directe du nouveau projet, nécessaire pour appliquer le schéma.
SUPABASE_DB_URL=
SUPABASE_DEMO_PROJECT_ID=
SUPABASE_PRODUCTION_PROJECT_ID=
# Mot de passe exclusivement réservé aux comptes Demo. À définir dans le gestionnaire de secrets.
SEED_AUTH_PASSWORD=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=

# L'authentification WhatsApp est portée par apps/api via Twilio Verify.
