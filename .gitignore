# Elima npm monorepo.
# Reference projects stay local and are not versioned by this mobile repo.
_references/
/mobile/

node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/dist-revision/
apps/*/.next/
apps/*/.env
apps/*/.env.local
.expo/
dist/
dist-revision/
tmp/revision-browser-tools/
tmp/revision-qa/
tmp/revision-smoke.mjs
supabase/generated/
supabase/backups/
build/
coverage/
.env
.env.*
!.env.example

*.log
*.tsbuildinfo
.DS_Store
Thumbs.db

# Android upload/release signing material stays local.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
keystore.local.properties
