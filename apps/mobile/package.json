{
  "name": "@elima/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:revision": "vite --config vite.revision.config.ts --configLoader runner",
    "build": "tsc --noEmit && vite build",
    "build:revision": "tsc --noEmit && vite build --config vite.revision.config.ts --configLoader runner",
    "preview": "vite preview",
    "preview:revision": "vite preview --config vite.revision.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --config eslint.config.mjs",
    "test": "npm run test:learning && npm run test:revision && npm run test:api",
    "test:learning": "node --experimental-strip-types --test ../../tests/learning/*.test.ts",
    "test:revision": "node --experimental-strip-types --test ../../tests/revision/*.test.ts",
    "test:api": "node --experimental-strip-types --test ../../tests/api/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.475.0",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "@elima/shared-domain": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.35",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
