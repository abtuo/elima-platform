# Toutes les variables VITE_* sont publiques dans le bundle client. Aucun secret serveur.
VITE_APP_ENV=production
VITE_APP_MODE=production
VITE_WEB_BASE_URL=https://elima.ci

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_DEMO_PROJECT_ID=
VITE_SUPABASE_PRODUCTION_PROJECT_ID=

VITE_ELIMA_IDENTITY_URL=
VITE_ELIMA_OAUTH_CLIENT_ID=
VITE_ELIMA_OAUTH_REDIRECT_URI=https://revision.elima.ci/auth/elima/callback
ELIMA_IDENTITY_PUBLISHABLE_KEY=

# Middleware Vite local uniquement : source Identity puis cible technique Révision.
ELIMA_IDENTITY_URL=
REVISION_SUPABASE_URL=
REVISION_SUPABASE_PUBLISHABLE_KEY=
REVISION_SUPABASE_SECRET_KEY=

# Vide = same-origin. Une origine distante doit être HTTPS hors développement local.
VITE_REVISION_API_BASE_URL=https://elima-api.vercel.app/
VITE_ENABLE_DEMO_MODE=false

# Démo locale uniquement : VITE_APP_ENV=development, VITE_APP_MODE=demo et VITE_ENABLE_DEMO_MODE=true.

# Backend local uniquement, sans préfixe VITE_.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
