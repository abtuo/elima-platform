# Projet d'identité central Elima. En production, la cible obligatoire est
# Core School / Identity : nnsgvnjzfrcmbxfwlyow.
# Pour la recette locale, utiliser uniquement
# l'URL locale retournée par `supabase status` (habituellement
# http://127.0.0.1:54321) et sa clé anon locale. Ne pas recopier une cible
# distante tant que son caractère staging n'a pas été vérifié explicitement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API centrale Elima qui porte Twilio Verify et l'échange de session Identity.
ELIMA_API_BASE_URL=https://api.elima.ci
# URL publique de la boutique.
NEXT_PUBLIC_STORE_URL=http://localhost:3002
# Source par défaut : base persistante. Le mode démo n'est accepté qu'en développement.
STORE_CATALOG_MODE=database
# Pour la seule QA visuelle locale sans base : STORE_CATALOG_MODE=demo.
