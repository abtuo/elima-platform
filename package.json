{
  "name": "elima-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "db:bundle": "node scripts/prepare-unified-db.mjs",
    "db:migrate": "node --env-file=.env scripts/apply-unified-db.mjs",
    "db:reset": "npx supabase db reset",
    "db:push:production": "node --env-file=.env scripts/push-production.mjs",
    "db:migrate:communications": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715120000_communications_split_and_user_delete.sql",
    "db:migrate:quiz-feedback": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715130000_quiz_feedback.sql",
    "db:migrate:timetable": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715140000_demo_timetable_structure.sql",
    "db:migrate:attendance-sync": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715150000_teacher_attendance_sync.sql",
    "db:migrate:registration-requests": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260716090000_school_registration_requests.sql",
    "db:migrate:student-class-profile": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260719120000_student_class_profile_access.sql",
    "db:migrate:learning": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260719150000_learning_assignments.sql",
    "db:migrate:learning-ai": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260719160000_learning_discovery_and_ai.sql",
    "db:migrate:guided-sessions": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260719170000_guided_sessions_v3.sql",
    "db:reload:schema": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715151000_reload_attendance_sync_schema.sql",
    "db:seed:quizzes:dry": "node scripts/seed-unified-quizzes.mjs --dry-run",
    "db:seed:quizzes:strict": "node scripts/seed-unified-quizzes.mjs --dry-run --strict",
    "db:seed:quizzes": "node --env-file=.env scripts/seed-unified-quizzes.mjs",
    "db:seed:demo": "node --env-file=.env scripts/seed-school-demo.mjs",
    "db:seed:demo-history": "node --env-file=.env scripts/seed-demo-quiz-history.mjs",
    "demo:reset": "node --env-file=.env scripts/reset-demo.mjs",
    "demo:reset:dry": "node --env-file=.env scripts/reset-demo.mjs --dry-run",
    "demo:verify": "node --env-file=.env scripts/verify-demo-seed.mjs",
    "db:seed:demo-timetable:check": "node scripts/seed-demo-timetable.mjs --check",
    "db:seed:demo-timetable": "node --env-file=.env scripts/seed-demo-timetable.mjs",
    "db:verify": "node --env-file=.env scripts/verify-unified-db.mjs",
    "import:learning-content": "node --env-file=.env --experimental-strip-types scripts/import-learning-content.ts",
    "import:guided-content": "node --env-file=.env --experimental-strip-types scripts/import-learning-content.ts --guided-only",
    "verify:learning-content": "node --env-file=.env --experimental-strip-types scripts/verify-learning-content.ts",
    "audit:guided-content": "node --env-file=.env --experimental-strip-types scripts/audit-guided-content.ts",
    "storage:fix-learning-paths": "node --env-file=.env scripts/fix-learning-storage-paths.mjs",
    "dev:platform": "npm run dev --workspace @elima/platform --",
    "build:platform": "npm run build --workspace @elima/platform",
    "typecheck:platform": "npm run typecheck --workspace @elima/platform",
    "lint:platform": "npm run lint --workspace @elima/platform",
    "dev:api": "npm run dev --workspace @elima/api --",
    "build:api": "npm run build --workspace @elima/api",
    "typecheck:api": "npm run typecheck --workspace @elima/api",
    "lint:api": "npm run lint --workspace @elima/api",
    "dev:mobile": "npm run dev --workspace @elima/mobile --",
    "build:mobile": "npm run build --workspace @elima/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @elima/mobile",
    "lint:mobile": "npm run lint --workspace @elima/mobile",
    "dev:revision": "npm run dev --workspace @elima/revision --",
    "build:revision": "npm run build --workspace @elima/revision",
    "build:revision:web": "npm run build:web --workspace @elima/revision",
    "build:revision:native": "npm run build:native --workspace @elima/revision",
    "preview:revision": "npm run preview --workspace @elima/revision",
    "dev": "npm run dev:mobile",
    "build": "npm run build:api && npm run build:platform && npm run build:mobile && npm run build:revision",
    "build:all": "npm run build",
    "preview": "npm run preview --workspace @elima/mobile",
    "typecheck": "npm run typecheck:packages && npm run typecheck:api && npm run typecheck:mobile && npm run typecheck:revision && npm run typecheck:platform",
    "typecheck:revision": "npm run typecheck --workspace @elima/revision",
    "typecheck:packages": "npm run typecheck --workspace @elima/shared-domain && npm run typecheck --workspace @elima/api-client && npm run typecheck --workspace @elima/supabase-client && npm run typecheck --workspace @elima/auth && npm run typecheck --workspace @elima/revision-core && npm run typecheck --workspace @elima/revision-ui",
    "typecheck:all": "npm run typecheck",
    "test": "npm run test:packages && npm run test:api && npm run test:mobile && npm run test:revision && npm run test:platform",
    "test:packages": "npm test --workspace @elima/api-client && npm test --workspace @elima/supabase-client && npm test --workspace @elima/auth && npm test --workspace @elima/revision-core && npm test --workspace @elima/revision-ui",
    "test:platform": "npm test --workspace @elima/platform",
    "test:mobile": "npm test --workspace @elima/mobile",
    "test:learning": "node --experimental-strip-types --test tests/learning/*.test.ts",
    "test:revision": "npm test --workspace @elima/revision",
    "test:api": "npm test --workspace @elima/api",
    "lint": "npm run lint:root && npm run lint:api && npm run lint:mobile && npm run lint:revision && npm run lint:platform",
    "lint:revision": "npm run lint --workspace @elima/revision",
    "lint:root": "eslint .",
    "lint:all": "npm run lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
