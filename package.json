{
  "name": "elima-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:bundle": "node scripts/prepare-unified-db.mjs",
    "db:migrate": "node --env-file=.env scripts/apply-unified-db.mjs",
    "db:migrate:communications": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715120000_communications_split_and_user_delete.sql",
    "db:migrate:quiz-feedback": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715130000_quiz_feedback.sql",
    "db:migrate:timetable": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715140000_demo_timetable_structure.sql",
    "db:migrate:attendance-sync": "node --env-file=.env scripts/apply-migration-file.mjs --file=supabase/migrations/20260715150000_teacher_attendance_sync.sql",
    "db:seed:quizzes:dry": "node scripts/seed-unified-quizzes.mjs --dry-run",
    "db:seed:quizzes:strict": "node scripts/seed-unified-quizzes.mjs --dry-run --strict",
    "db:seed:quizzes": "node --env-file=.env scripts/seed-unified-quizzes.mjs",
    "db:seed:demo": "node --env-file=.env scripts/seed-school-demo.mjs",
    "db:seed:demo-history": "node --env-file=.env scripts/seed-demo-quiz-history.mjs",
    "db:seed:demo-timetable:check": "node scripts/seed-demo-timetable.mjs --check",
    "db:seed:demo-timetable": "node --env-file=.env scripts/seed-demo-timetable.mjs",
    "db:verify": "node --env-file=.env scripts/verify-unified-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.475.0",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
