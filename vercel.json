{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/revision-generate.mjs": {
      "maxDuration": 60
    },
    "api/elima-password-login.mjs": {
      "maxDuration": 15
    },
    "api/elima-signup.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
