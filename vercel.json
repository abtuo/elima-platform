{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:mobile",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src public api assets data packages supabase package.json package-lock.json vite.config.ts vercel.json",
  "functions": {
    "api/revision-generate.mjs": {
      "maxDuration": 60
    },
    "api/elima-password-login.mjs": {
      "maxDuration": 15
    },
    "api/elima-signup.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
